#!/usr/bin/env bash
# Copy to credentials.sh (gitignored) and fill in. cluster/env.sh sources it in every job.
#   cp credentials.sh.example credentials.sh && chmod 600 credentials.sh

# 1. NASA Earthdata (https://urs.earthdata.nasa.gov): OB.DAAC (MODIS, VIIRS, OLCI, PACE),
#    PO.DAAC (MUR SST, CCMP winds) and GES DISC (IMERG).
#    In the Earthdata profile approve these applications (Applications > Authorized Apps):
#      "OB.DAAC Data Access", "PO.DAAC Drive", "NASA GESDISC DATA ARCHIVE"
export EARTHDATA_USERNAME='your_earthdata_username'
export EARTHDATA_PASSWORD='your_earthdata_password'
# or a token from the profile's "Generate Token" page:
# export EARTHDATA_TOKEN='eyJ...'

# 2. Copernicus Marine (https://marine.copernicus.eu): altimetry and GlobCurrent.
#    The same account as for biogoship_granite_kegg's download_currents.py.
export COPERNICUSMARINE_SERVICE_USERNAME='your_marine_username'
export COPERNICUSMARINE_SERVICE_PASSWORD='your_marine_password'
